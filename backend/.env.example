# Copy this file to `.env` (same folder) and fill in your token.
# Without it, the backend falls back to the free Open-Elevation API (coarse SRTM).
#
# Get a token at https://account.mapbox.com/access-tokens/
# A default public token (starts with "pk.") is enough; it needs the
# "Vector Tiles API" / terrain access that the default token already has.
MAPBOX_TOKEN=pk.your_token_here
